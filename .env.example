RHC_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# Alchemy endpoint for Robinhood Chain mainnet, chain 4663.
# Dashboard -> your app -> Endpoints tab -> copy the HTTPS URL.
#
# Copy this file to .env and paste your real key in. .env is gitignored.
#
# Foundry only. This key must never appear anywhere under app/. Vite
# inlines VITE_* variables into the static bundle and this repo is
# public, so a key there is a published key. The front end runs on the
# public RPC on purpose and does not need one.
